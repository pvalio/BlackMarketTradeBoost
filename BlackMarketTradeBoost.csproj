<Project Sdk="Microsoft.NET.Sdk">
  <!--
    Build:  dotnet build -c Release -p:GameDir="<path to your MENACE folder>"
    BepInEx 6 (IL2CPP) must be installed in the game folder and the game
    launched once, so BepInEx/interop is generated.
  -->
  <PropertyGroup>
    <TargetFramework>net6.0</TargetFramework>
    <AssemblyName>MenaceTweaks</AssemblyName>
    <LangVersion>latest</LangVersion>
    <Nullable>disable</Nullable>
    <CheckEolTargetFramework>false</CheckEolTargetFramework>
    <GameDir Condition="'$(GameDir)' == ''">C:\Program Files (x86)\Steam\steamapps\common\Menace</GameDir>
  </PropertyGroup>
  <ItemGroup>
    <Reference Include="$(GameDir)/BepInEx/core/*.dll" Private="false" />
    <Reference Include="$(GameDir)/BepInEx/interop/*.dll" Private="false" />
  </ItemGroup>
  <Target Name="InstallPlugin" AfterTargets="Build" Condition="Exists('$(GameDir)/BepInEx')">
    <MakeDir Directories="$(GameDir)/BepInEx/plugins/MenaceTweaks" />
    <Copy SourceFiles="$(TargetPath)" DestinationFolder="$(GameDir)/BepInEx/plugins/MenaceTweaks" />
  </Target>
</Project>
